{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hartmaatje.local/contracts/events.json",
  "title": "HartMaatje realtime event envelope",
  "description": "Alle control-events gebruiken één JSON envelope. Audio gaat via WebRTC of binaire WS-frames.",
  "type": "object",
  "required": ["type", "session_id", "seq", "ts", "source", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "session.start",
        "session.keepalive",
        "audio.start",
        "audio.end",
        "stream.finalize",
        "interrupt",
        "ready",
        "speech.start",
        "stt.partial",
        "speech.end",
        "stt.final",
        "state.update",
        "llm.partial",
        "tool.call",
        "tool.result",
        "tts.start",
        "tts.chunk",
        "tts.stop",
        "barge.ack",
        "retrieval.query",
        "retrieval.result",
        "place.lookup",
        "place.result",
        "ui.map_render",
        "error",
        "done"
      ]
    },
    "session_id": { "type": "string" },
    "turn_id": { "type": ["string", "null"] },
    "seq": { "type": "integer", "minimum": 0 },
    "ts": { "type": "string", "format": "date-time" },
    "source": {
      "type": "string",
      "enum": [
        "client",
        "api",
        "media-gateway",
        "stt-worker",
        "llm-worker",
        "tts-worker",
        "system"
      ]
    },
    "payload": { "type": "object" }
  },
  "examples": [
    {
      "type": "stt.partial",
      "session_id": "sess_123",
      "turn_id": "turn_001",
      "seq": 4,
      "ts": "2026-07-20T03:00:01.900Z",
      "source": "stt-worker",
      "payload": {
        "text": "ik wil naar parijs",
        "confidence": 0.72,
        "language": "nl",
        "segment_id": "seg_001",
        "offset_ms": 120,
        "duration_ms": 760,
        "is_final": false
      }
    },
    {
      "type": "interrupt",
      "session_id": "sess_123",
      "turn_id": "turn_002",
      "seq": 18,
      "ts": "2026-07-20T03:00:12.010Z",
      "source": "client",
      "payload": {
        "reason": "user_speech_detected_during_tts",
        "stop_audio_before_seq": 18,
        "playback_position_ms": 860
      }
    }
  ]
}

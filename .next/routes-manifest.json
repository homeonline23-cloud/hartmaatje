{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-src 'self' https://www.youtube-nocookie.com https://youtube-nocookie.com https://*.youtube-nocookie.com https://www.youtube.com https://youtube.com; media-src 'self' blob: https://www.youtube-nocookie.com https://youtube-nocookie.com https://*.youtube-nocookie.com https://www.youtube.com https://*.googlevideo.com; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss: ws: http://127.0.0.1:8000 http://localhost:8000 http://127.0.0.1:9000 http://localhost:9000; font-src 'self' data:"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/avatar/video/[name]",
      "regex": "^/api/avatar/video/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPname": "nxtPname"
      },
      "namedRegex": "^/api/avatar/video/(?<nxtPname>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/dubber/jobs/[id]",
      "regex": "^/api/dubber/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/dubber/jobs/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/dubber/jobs/[id]/download",
      "regex": "^/api/dubber/jobs/([^/]+?)/download(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/dubber/jobs/(?<nxtPid>[^/]+?)/download(?:/)?$"
    },
    {
      "page": "/api/dubber/jobs/[id]/install-story",
      "regex": "^/api/dubber/jobs/([^/]+?)/install\\-story(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/dubber/jobs/(?<nxtPid>[^/]+?)/install\\-story(?:/)?$"

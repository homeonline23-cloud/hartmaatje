{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/gesprek/layout,_N_T_/gesprek/[id]/layout,_N_T_/gesprek/[id]/page,_N_T_/gesprek/peter"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/gesprek/$d$id/__PAGE__",
    "/gesprek/$d$id",
    "/gesprek",
    "/_index",
    "/_head"
  ]
}
{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/maatjes/layout,_N_T_/maatjes/page,_N_T_/maatjes"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/maatjes/__PAGE__",
    "/maatjes",
    "/_index",
    "/_head"
  ]
}
# =============================================================================
# VOORBEELD — dit bestand wordt niet door de app gelezen.
# Kopieer naar:  backend/.env   (zelfde map) en vul de echte waarden in.
# =============================================================================

# --- Google Gemini (LLM + STT + TTS) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Sneller voor microfoon-transcriptie (standaard in code: gemini-2.5-flash-lite)
# GEMINI_STT_MODEL=gemini-2.5-flash-lite
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# FENNA_VOICE_NAME=Aoede

# --- CORS (frontend origins die de API mogen aanroepen) ---
# Standaard staan localhost:3000/3010/5500 al toe (zie config.py).
# CORS_ORIGINS=http://localhost:3010,https://hartmaatje.app

# --- Memory backend: json | sqlite | postgres ---
# MEMORY_BACKEND=json
# DATABASE_URL=

# --- Staff alerts (nood/emotionele signalen) ---
# STAFF_ALERT_WEBHOOK_URL=
# STAFF_ALERT_WEBHOOK_SECRET=
# CARE_HOME_ID=pilot-home-1

# --- Voice-changer — eigen gekloonde stemmen per personage (RVC) ---
# Zet een geheime sleutel om /voice-models upload/verwijder-endpoints te
# gebruiken vanaf de /voice-changer pagina in de frontend. Leeg = uitgeschakeld.
ADMIN_API_KEY=

# Map waar geuploade .pth/.index modelbestanden worden opgeslagen.
# Standaard: backend/data/voice_models/{persona}/
# VOICE_MODELS_DIR=

# "cpu:0" | "cuda:0" | "mps" — vereist backend/requirements-voice.txt
# RVC_DEVICE=cpu:0
